# Production environment for Render deployment
# These variables should be set in Render dashboard for security
DB_URL=jdbc:mysql://your-aiven-host:your-port/your-db?sslMode=REQUIRED
DB_USER=your-aiven-user
DB_PASSWORD=your-aiven-password
JWT_SECRET=your-production-jwt-secret-min-32-chars
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=https://your-vercel-frontend-url.vercel.app
SERVER_PORT=8080
